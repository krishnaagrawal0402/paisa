# ─────────────────────────────────────────────────────────────────────────────
# Paisa configuration. Easiest path: `npm run setup` writes .env.local for you.
# Full guide: docs/SELF_HOSTING.md
# ─────────────────────────────────────────────────────────────────────────────

# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Settings → API Keys → Publishable key (the legacy "anon" key also works,
# as NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Connect → "Session pooler" connection string (works from Vercel, which has no IPv6).
# Used only at deploy time to apply migrations. URL-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.your-project:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Who may sign up, comma-separated. Leave empty to allow anyone (not recommended
# for a personal instance). Enforced in the app AND by a database trigger.
ALLOWED_EMAILS=you@example.com

# Optional: show "Continue with Google" (enable the Google provider in Supabase first).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Optional: public URL of this instance, used in sign-in emails.
# Defaults to the URL the request came in on.
# SITE_URL=https://paisa.example.com
